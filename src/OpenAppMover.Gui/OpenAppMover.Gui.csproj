<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <!-- Allows building on Linux/macOS (the application itself only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>openappmover-gui</AssemblyName>
    <RootNamespace>OpenAppMover.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from Assets\openappmover*.svg by tools/build-icon.sh. -->
    <ApplicationIcon>Assets\openappmover.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Windows 10/11: self-contained single file. -->
  <PropertyGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <!-- Legacy build (Windows 7 SP1, 8.1): .NET Framework 4.8 x64, the dependencies merged into the exe by Costura (FodyWeavers.xml). -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <AssemblyName>openappmover-gui-legacy</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\openappmover.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenAppMover.Host\OpenAppMover.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
