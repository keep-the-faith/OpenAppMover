<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>openappmover</AssemblyName>
    <RootNamespace>OpenAppMover.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\OpenAppMover.Gui\Assets\openappmover.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Windows 10/11: self-contained single file. -->
  <PropertyGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <!-- Legacy build (Windows 7 SP1, 8.1): .NET Framework 4.8 x64, the dependencies merged into the exe by Costura (FodyWeavers.xml). -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <AssemblyName>openappmover-legacy</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Fody" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenAppMover.Host\OpenAppMover.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
